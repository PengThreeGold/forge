[flake8]
max-line-length = 120
exclude = 
    .git,
    __pycache__,
    venv,
    env,
    .venv,
    .env,
    backend/venv,
    backend/env,
    backend/.venv,
    backend/.env,
    node_modules,
    build,
    dist,
    *.egg-info
ignore = 
    E203,  # whitespace before ':'
    W503,  # line break before binary operator
    E501,  # line too long
    F401   # imported but unused
per-file-ignores =
    __init__.py:F401
max-complexity = 10
