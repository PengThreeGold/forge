# 生产环境配置
NODE_ENV=production
VUE_APP_TITLE=Forge 软件发布管理平台

# API基础URL - 生产环境中应替换为实际的API服务器地址
VUE_APP_API_URL=https://api.forge.com

# CORS 配置
VUE_APP_CORS_ORIGIN=https://forge.com
VUE_APP_CORS_CREDENTIALS=true

# 请求超时时间（毫秒）
VUE_APP_TIMEOUT=30000

# 上传文件大小限制（字节）
VUE_APP_MAX_FILE_SIZE=524288000

# WebSocket URL
VUE_APP_WS_URL=wss://api.forge.com/ws

# 是否启用调试模式
VUE_APP_DEBUG=false