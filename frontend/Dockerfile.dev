# Forge 软件发布管理平台 - 前端开发环境 Dockerfile
# 使用 Node.js 16 作为基础镜像
FROM node:16-alpine

# 安装git
RUN apk add --no-cache git

# 设置工作目录
WORKDIR /app

# 复制package.json和package-lock.json
COPY package*.json ./

# 安装依赖
RUN npm ci

# 暴露端口
EXPOSE 8080

# 创建非root用户
RUN addgroup -g 1001 -S nodejs \
    && adduser -S nodejs -u 1001

# 设置正确的权限
RUN chown -R nodejs:nodejs /app
USER nodejs

# 启动开发服务器
CMD ["npm", "run", "serve"]