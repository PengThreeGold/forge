# 开发环境配置
NODE_ENV=development
VUE_APP_TITLE=Forge 软件发布管理平台

# API基础URL
VUE_APP_API_URL=http://localhost:5000

# 请求超时时间（毫秒）
VUE_APP_TIMEOUT=30000

# 是否启用HTTPS
VUE_APP_HTTPS_ENABLED=false

# 上传文件大小限制（字节）
VUE_APP_MAX_FILE_SIZE=524288000

# WebSocket URL
VUE_APP_WS_URL=ws://localhost:5000/ws

# 是否启用调试模式
VUE_APP_DEBUG=true