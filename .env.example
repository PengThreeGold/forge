# Forge 软件发布管理平台 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# 安全密钥
# 在生产环境中，请使用随机生成的字符串
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# HTTPS 配置
# 如果设置为 true，则需要提供有效的SSL证书
HTTPS_ENABLED=true

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=forge

# Redis 配置
REDIS_PASSWORD=redis-password

# 前端配置
VUE_APP_API_URL=https://your-domain.com/api
VUE_APP_TITLE=Forge 软件发布管理平台
VUE_APP_DESCRIPTION=软件版本发布管理平台
VUE_APP_VERSION=1.0.0

# 后端配置
FLASK_CONFIG=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 文件上传配置
MAX_CONTENT_LENGTH=524288000  # 500MB
UPLOAD_FOLDER=/app/storage/uploads
SOFTWARE_STORAGE=/app/storage/software

# SSL证书路径
SSL_CERT_PATH=/etc/nginx/certs/your-domain.crt
SSL_KEY_PATH=/etc/nginx/certs/your-domain.key

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=/app/logs/forge.log

# 邮件配置（用于通知）
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password

# 管理员账户
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# API 密钥（可选）
API_KEY=your-api-key

# Webhook 配置
WEBHOOK_SECRET=your-webhook-secret